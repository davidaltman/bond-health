PORT=8790
FRONTEND_ORIGIN=http://127.0.0.1:5190

# ElevenLabs Conversational AI, personal sandbox account.
# Required for voice calls (/api/signed-url). Nothing else needs it.
BOND_ELEVEN_LABS_API_KEY=

# LLM provider for extraction, decisions, and follow-ups.
# Personal key -- this project must not use any employer account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: the insights/patterns pass (followups.ts) makes judgment calls
# across several people's records, so it can be pointed at a stronger model.
# Falls back to OPENAI_MODEL when unset.
# FOLLOWUPS_OPENAI_MODEL=gpt-5.4

# Legacy: the original prototype ran extraction on AWS Bedrock via an
# employer SSO profile. Unused once the OpenAI path lands; kept only so old
# transcripts in docs/ still make sense.
# AWS_REGION=us-west-2
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# FOLLOWUPS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
